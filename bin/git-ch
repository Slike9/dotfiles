#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

query=${1-}

if [ "$query" = "-" ]; then
  git checkout -
else
  git branch --sort=committerdate --format='%(refname:short)' |
    fzf --tac --no-sort --query="$query" --select-1 |
    while IFS= read -r branch; do
      [[ -n "$branch" ]] && git checkout "$branch"
    done
fi
