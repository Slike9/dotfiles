#!/usr/bin/env bash
set -euo pipefail

dotfiles_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
skipped=()
configs_only=false
case "${1:-}" in
  --configs-only) configs_only=true; shift ;;
  -h|--help)
    printf 'Usage: %s [--configs-only]\n' "$0"
    printf '  --configs-only  Apply config links and Bash extension without installing packages.\n'
    exit 0
    ;;
esac
if (( $# )); then
  printf 'Unknown argument: %s\nUsage: %s [--configs-only]\n' "$1" "$0" >&2
  exit 1
fi

if [[ ! -e "$HOME/.bashrc" && ! -L "$HOME/.bashrc" ]]; then
  printf 'Missing required file: %s\n' "$HOME/.bashrc" >&2
  exit 1
fi

link_file() {
  local source="$dotfiles_root/config/$1" destination="$HOME/$2"
  if [[ "$source" -ef "$destination" ]]; then
    printf 'Already linked: %s\n' "$destination"
  elif [[ -e "$destination" || -L "$destination" ]]; then
    printf 'Skipped existing path: %s\n' "$destination"
    skipped+=("$destination")
  else
    mkdir -p -- "$(dirname -- "$destination")"
    ln -s -- "$source" "$destination"
    printf 'Linked: %s\n' "$destination"
  fi
}

if [[ "$configs_only" == false ]]; then
  if ! command -v apt-get >/dev/null; then
    printf 'This setup requires Debian/Ubuntu (apt-get).\n' >&2
    exit 1
  fi

  export PATH="$HOME/.local/bin:$PATH"
  if ! command -v mise >/dev/null; then
    if ! command -v curl >/dev/null; then
      printf 'Installing mise requires curl and CA certificates. Install them first.\n' >&2
      exit 1
    fi
    curl -fsSL https://mise.run | sh
  fi

  if ! mise -C "$HOME" bootstrap packages apply --help >/dev/null 2>&1; then
    printf 'This setup requires mise with bootstrap packages support. Update mise and rerun setup.\n' >&2
    exit 1
  fi
fi

link_file git/gitconfig.symlink .gitconfig
link_file git/gitignore.symlink .gitignore
link_file git/gitattributes.symlink .gitattributes
link_file ignore.symlink .ignore
link_file tmux/tmux.conf.symlink .tmux.conf
link_file ruby/irbrc.symlink .irbrc
link_file vim/my_vim.symlink .my_vim
link_file nvim .config/nvim
link_file mise/config.toml .config/mise/config.toml

if [[ -L "$HOME/.bashrc" || ( -e "$HOME/.bashrc" && ! -f "$HOME/.bashrc" ) ]]; then
  printf 'Skipped existing path: %s\n' "$HOME/.bashrc"
  skipped+=("$HOME/.bashrc")
else
  # shellcheck disable=SC2016
  if ! grep -Fqx '  source "$HOME/.dotfiles/config/bash/extension.bash"' "$HOME/.bashrc"; then
    cat >> "$HOME/.bashrc" <<'EOF'

# dotfiles extension
if [ -f "$HOME/.dotfiles/config/bash/extension.bash" ]; then
  source "$HOME/.dotfiles/config/bash/extension.bash"
fi
EOF
  fi
fi

if [[ "$configs_only" == true ]]; then
  printf 'Skipped package and tool installation: configs-only mode.\n'
elif [[ "$dotfiles_root/config/mise/config.toml" -ef "$HOME/.config/mise/config.toml" ]]; then
  mise -C "$HOME" bootstrap packages apply --manager apt --yes
  mise -C "$HOME" install
else
  printf 'Skipped package and tool installation: global mise config was not linked.\n'
fi

if (( ${#skipped[@]} )); then
  printf '\nSetup finished with skipped paths:\n'
  printf '  %s\n' "${skipped[@]}"
else
  printf '\nSetup complete. Open a new Bash session.\n'
fi
